{
  "name": "sample-json-contracts",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "imports": {
    "#/*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./src/*.ts"
    },
    "#": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "decimal.js": "^10.6.0",
    "metano-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260225.1"
  },
  "scripts": {
    "generate": "dotnet run --project ../../../src/Metano.Compiler.TypeScript/Metano.Compiler.TypeScript.csproj -- -p ../../../samples/SampleJsonContracts/SampleJsonContracts.csproj -o ./src --clean --time",
    "build": "tsgo -b .",
    "test": "bun test"
  },
  "exports": {
    "./sample-json-contracts": {
      "source": "./src/sample-json-contracts/index.ts",
      "types": "./dist/sample-json-contracts/index.d.ts",
      "import": "./dist/sample-json-contracts/index.js"
    }
  }
}
