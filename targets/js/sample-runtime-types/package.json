{
  "name": "sample-runtime-types",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "dependencies": {
    "metano-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260225.1"
  },
  "scripts": {
    "generate": "dotnet run --project ../../../src/Metano.Compiler.TypeScript/Metano.Compiler.TypeScript.csproj -- -p ../../../samples/SampleRuntimeTypes/SampleRuntimeTypes.csproj -o ./src --clean --time",
    "build": "tsgo -b .",
    "test": "bun test"
  },
  "exports": {
    "./sample-runtime-types/interop": {
      "source": "./src/sample-runtime-types/interop/index.ts",
      "types": "./dist/sample-runtime-types/interop/index.d.ts",
      "import": "./dist/sample-runtime-types/interop/index.js"
    },
    "./sample-runtime-types/shapes": {
      "source": "./src/sample-runtime-types/shapes/index.ts",
      "types": "./dist/sample-runtime-types/shapes/index.d.ts",
      "import": "./dist/sample-runtime-types/shapes/index.js"
    },
    "./sample-runtime-types/unions": {
      "source": "./src/sample-runtime-types/unions/index.ts",
      "types": "./dist/sample-runtime-types/unions/index.d.ts",
      "import": "./dist/sample-runtime-types/unions/index.js"
    }
  }
}
