{
  "name": "metano-runtime",
  "version": "0.1.0",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "description": "Runtime support library for Metano-generated TypeScript code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danfma/metano.git",
    "directory": "js/metano-runtime"
  },
  "files": [
    "dist/**/*",
    "src/**/*.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./system/json": {
      "source": "./src/system/json/index.ts",
      "types": "./dist/system/json/index.d.ts",
      "import": "./dist/system/json/index.js"
    },
    "./system/linq": {
      "source": "./src/system/linq/index.ts",
      "types": "./dist/system/linq/index.d.ts",
      "import": "./dist/system/linq/index.js"
    },
    "./system/collections": {
      "source": "./src/system/collections/index.ts",
      "types": "./dist/system/collections/index.d.ts",
      "import": "./dist/system/collections/index.js"
    },
    "./system/exceptions": {
      "source": "./src/system/exceptions/index.ts",
      "types": "./dist/system/exceptions/index.d.ts",
      "import": "./dist/system/exceptions/index.js"
    },
    "./system/reflection": {
      "source": "./src/system/reflection/index.ts",
      "types": "./dist/system/reflection/index.d.ts",
      "import": "./dist/system/reflection/index.js"
    },
    "./system/collections/*.js": {
      "source": "./src/system/collections/*.ts",
      "types": "./dist/system/collections/*.d.ts",
      "import": "./dist/system/collections/*.js"
    },
    "./system/collections/*": {
      "source": "./src/system/collections/*.ts",
      "types": "./dist/system/collections/*.d.ts",
      "import": "./dist/system/collections/*.js"
    },
    "./system/exceptions/*.js": {
      "source": "./src/system/exceptions/*.ts",
      "types": "./dist/system/exceptions/*.d.ts",
      "import": "./dist/system/exceptions/*.js"
    },
    "./system/exceptions/*": {
      "source": "./src/system/exceptions/*.ts",
      "types": "./dist/system/exceptions/*.d.ts",
      "import": "./dist/system/exceptions/*.js"
    },
    "./package.json": "./package.json",
    "./*.js": "./dist/*.js",
    "./*": "./dist/*.js"
  },
  "imports": {
    "#/*": [
      "./dist/*",
      "./src/*"
    ]
  },
  "scripts": {
    "build": "tsgo -b .",
    "test": "bun test",
    "bench": "bun bench/collections.bench.ts",
    "bench:node": "node --experimental-transform-types --no-warnings bench/collections.bench.ts",
    "bench:json": "bun bench/json/run.ts",
    "bench:int64": "bun bench/int64/run.ts"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@types/bun": "^1.3.11",
    "@typescript/native-preview": "^7.0.0-dev.20260225.1",
    "bun-types": "^1.3.11",
    "esbuild": "0.28.2",
    "rollup": "4.68.7"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "decimal.js": "^10.6.0"
  }
}
