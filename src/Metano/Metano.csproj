<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
            Targets net10.0 only. .NET 8 and .NET 9 reach end of support on
            2026-11-10, so they were dropped; a net10.0 library also loads in .NET 11
            applications. net11.0 is added once the .NET 11 SDK is GA and CI builds
            with it.
        -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Annotations and BCL runtime mappings for the Metano C#-to-TypeScript transpiler</Description>
  </PropertyGroup>
</Project>
