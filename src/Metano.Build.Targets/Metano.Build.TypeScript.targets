<Project>
  <!--
    Metano.Build.TypeScript: automatic TypeScript generation (ADR-0029, FR-085, FR-086).

    Runs the metano-typescript CLI after a successful Build when the
    TypeScript output directory resolves to a value. The CLI reads the
    compiled assembly via Roslyn, transforms annotated types into a TypeScript
    AST, and writes .ts files to the output directory. The target-independent
    worker lives in Metano.Build.Common.targets, shipped next to this file.

    Setting resolution (FR-086): every setting S below is read as
    $(MetanoTs<S>), else $(Metano<S>), else the default; an empty value counts
    as unset. The unprefixed name is the global setting every enabled Metano
    target reads, so a single-target project keeps using it. With several
    targets, prefer the prefixed form for MetanoCompilerProject,
    MetanoExtraArgs and MetanoPostBuildCommand: the global value reaches every
    enabled target. Settings are resolved when the build runs, so values set
    in Directory.Build.targets count.

    Configurable properties (set in the consuming .csproj; S = the name
    without the `Metano` prefix):

      MetanoOutputDir        (required)  Where to write .ts files
      MetanoEnabled          (optional)  Opt-out switch. Defaults to true when
                                         the output dir resolves; set to false to
                                         skip the transpile target without unsetting
                                         the output dir (e.g., in CI variants that
                                         only want the .NET build).
      MetanoClean            (optional)  true to wipe the output dir first (default: false).
                                         Rarely needed: incremental builds self-prune orphaned
                                         generated files by reconciling the cache manifest, so a
                                         renamed/moved/deleted type no longer leaves stale output.
      MetanoDist             (optional)  JS dist dir relative to package root (default: ./dist)
      MetanoPackageRoot      (optional)  Root of the npm package. Default: the nearest directory with a
                                         package.json, searching up from OutputDir but never past the
                                         workspace boundary (see docs/cross-package.md); without a match,
                                         the parent of OutputDir. Fails with MS0044 when that parent lies
                                         outside the workspace (#334).
      MetanoSrcRoot          (optional)  TS source root relative to package root (default: inferred)
      MetanoImportAlias      (optional)  Isolated subpath-imports alias for internal imports in generated TS (e.g. `contracts` → `#contracts/...`). Lets generated code live in a subfolder of an existing npm project without colliding with that project's own `#` alias. Leading `#` optional; use a simple identifier (letters, digits, `-`, `_`). Default: unset (uses `#`). When several Metano projects target the same package, give each a distinct alias.
      MetanoSourceCondition  (optional)  Name of the package.json export condition that resolves the generated package's `exports` and `imports` to its `.ts` sources (default: `source`). Set a package-specific name, recommended `metano-source`, so a consumer enables it for this package alone (Vite `resolve.conditions`, TypeScript `customConditions`) instead of opting every third-party package that exports `source` into raw-source resolution. Letters, digits, `-`, `_`, `.`, `:`; all-digit names, Node built-in conditions (`import`, `require`, `default`, `types`, `node`, `browser`, ...) and bundler defaults (`module`, `development`, `production`) fail with MS0059. Switching from the default replaces the `source` entry an earlier build wrote; after renaming between custom names, delete the old key. See docs/cross-package.md.
      MetanoSkipPackageJson  (optional)  true to skip package.json generation (default: false)
      MetanoShowTimings      (optional)  true to print timing info (default: false)
      MetanoNamespaceBarrels (optional)  true to emit a root src/index.ts barrel mirroring C# namespaces (default: false)
      MetanoStripInterfacePrefix (optional)  true to drop the `I` prefix from interface names when the second letter is uppercase (default: false). Collisions with sibling types surface MS0017.
      MetanoFilePrefix       (optional)  Verbatim text inserted at the top of every generated file, followed by a single newline. Use for formatter / lint directives (Biome `biome-ignore-all`, Prettier `// @prettier-ignore`, `// @generated` markers). Multi-line values are accepted; pass through MSBuild XML escaping.
      MetanoExtraArgs        (optional)  Additional CLI arguments
      MetanoPostBuildCommand (optional)  Shell command to run after transpilation completes. Receives the consumer's choice of formatter / linter / packager. Stays empty by default so the target ships no tool dependency; consumers opt in per project when they want the post-emit pass.
      MetanoSkipToolCheck    (optional)  true to skip the pre-flight check that the `metano-typescript` .NET tool is installed (default: false). The check only runs when the transpile target is out of date and not in dev mode (MetanoCompilerProject unset); when the tool is missing the build fails with METANOBUILD001 and the install instructions instead of the generic `dotnet-metano-typescript does not exist` message.
      MetanoCompilerProject  (optional)  Dev mode: path of the compiler .csproj, run with `dotnet run - -project` instead of the installed tool (no tool probe).

    Tool requirement:

      This package does NOT bundle the compiler: the target language is the
      consumer's choice. Install the TypeScript compiler as a .NET tool,
      preferably in a local tool manifest committed with the repository:

        dotnet new tool-manifest
        dotnet tool install Metano.Compiler.TypeScript

      or install it machine-wide with the tool install `global` flag.

    Incremental builds and Metano upgrades (#433):

      MetanoTranspileTs is skipped while every input is older than
      <resolved output dir>/.metano-stamp. Besides the user's sources, assets
      and project file, its inputs include a toolchain key file,
      $(IntermediateOutputPath)$(MSBuildProjectFile).MetanoToolchain.typescript.cache,
      rewritten only when its content changes. The content names the Metano
      toolchain: the path of Metano.Build.Common.targets (inside the versioned
      Metano.Build.TypeScript package folder), the referenced Metano.dll, and either
      MetanoCompilerProject (dev mode) or a hash of the nearest .NET tool
      manifest of each file name (.config/dotnet-tools.json and
      dotnet-tools.json) plus one line per installed global tool version
      folder. Bumping any of them rewrites the key, so the next build reruns
      the target, and the compiler
      treats a different compiler release as an incremental cache miss
      (.metano-cache.json), so the output is regenerated. The key is a content
      check on purpose: NuGet extracts package files with their pack-time
      timestamps, so the .targets file of a new package can be older than the
      stamp and listing it in Inputs alone would not rerun the target.

      The `no-incremental` flag of `dotnet build` (Rebuild) does not force a rerun: the
      stamp lives in the output directory, not in obj/, so Clean leaves it in
      place, and the compiled assembly is not an input. Delete the stamp to
      force a rerun (MetanoClean alone does not: it only applies when the
      target runs).

      Not tracked: a tool installed with the tool install `tool-path` option;
      a tool pinned in a manifest further up the tree than the nearest one
      (`dotnet tool` merges manifests upward until one sets `isRoot: true`,
      but MSBuild property functions cannot walk an open-ended chain, so only
      the nearest manifest of each file name is hashed); and edits to the
      compiler sources in dev mode (MetanoCompilerProject).

    Asset item type (FR-048):

      <MetanoAsset Include="schema.sql" />
        Copies the file from the project directory to <MetanoOutputDir>,
        mirroring the relative path. `schema.sql` lands at
        $(MetanoOutputDir)/schema.sql; `assets/seed.json` lands at
        $(MetanoOutputDir)/assets/seed.json.

      Supported per-item metadata:
        OutputPath (optional)  Output-relative destination path. Overrides
                               the mirrored default. Use to relocate the
                               asset without renaming the source file.
                               `Output` is reserved by MSBuild (MSB4118),
                               so the metadata name is `OutputPath`.
        Language   (optional)  Which transpiler this asset applies to.
                               `typescript`, `dart`, `all`, or empty (=all).
                               Items not matching the active language are
                               dropped before the CLI sees them, so they
                               don't perturb the incremental cache
                               fingerprint. The metadata name is `Language`
                               because `Target` is reserved by MSBuild
                               (MSB4066).

      Declare the same Include twice with different OutputPath values to
      ship the asset to multiple destinations.
  -->

  <Import
    Project="$(MSBuildThisFileDirectory)Metano.Build.Common.targets"
    Condition="'$(_MetanoBuildCommonImported)' != 'true'"
  />

  <PropertyGroup>
    <_MetanoResolveTargetsDependsOn>$(_MetanoResolveTargetsDependsOn);_MetanoResolveTs</_MetanoResolveTargetsDependsOn>
    <_MetanoTranspileTargets>$(_MetanoTranspileTargets);MetanoTranspileTs</_MetanoTranspileTargets>
  </PropertyGroup>

  <!-- FR-086: one line per setting, $(MetanoTs<S>) ?? $(Metano<S>) ?? default. The list is the
       contract; BuildSettingsContractTests keeps it in sync with the spec. Conditional
       assignments rather than ValueOrDefault keep any character of the value intact. -->
  <Target Name="_MetanoResolveTs">
    <PropertyGroup>
      <_MetanoTsOutputDir>$(MetanoOutputDir)</_MetanoTsOutputDir>
      <_MetanoTsOutputDir Condition="'$(MetanoTsOutputDir)' != ''"
        >$(MetanoTsOutputDir)</_MetanoTsOutputDir>
      <_MetanoTsEnabled>$(MetanoEnabled)</_MetanoTsEnabled>
      <_MetanoTsEnabled Condition="'$(MetanoTsEnabled)' != ''">$(MetanoTsEnabled)</_MetanoTsEnabled>
      <_MetanoTsEnabled Condition="'$(_MetanoTsEnabled)' == ''">true</_MetanoTsEnabled>
      <_MetanoTsClean>$(MetanoClean)</_MetanoTsClean>
      <_MetanoTsClean Condition="'$(MetanoTsClean)' != ''">$(MetanoTsClean)</_MetanoTsClean>
      <_MetanoTsShowTimings>$(MetanoShowTimings)</_MetanoTsShowTimings>
      <_MetanoTsShowTimings Condition="'$(MetanoTsShowTimings)' != ''"
        >$(MetanoTsShowTimings)</_MetanoTsShowTimings>
      <_MetanoTsDist>$(MetanoDist)</_MetanoTsDist>
      <_MetanoTsDist Condition="'$(MetanoTsDist)' != ''">$(MetanoTsDist)</_MetanoTsDist>
      <_MetanoTsPackageRoot>$(MetanoPackageRoot)</_MetanoTsPackageRoot>
      <_MetanoTsPackageRoot Condition="'$(MetanoTsPackageRoot)' != ''"
        >$(MetanoTsPackageRoot)</_MetanoTsPackageRoot>
      <_MetanoTsSrcRoot>$(MetanoSrcRoot)</_MetanoTsSrcRoot>
      <_MetanoTsSrcRoot Condition="'$(MetanoTsSrcRoot)' != ''">$(MetanoTsSrcRoot)</_MetanoTsSrcRoot>
      <_MetanoTsImportAlias>$(MetanoImportAlias)</_MetanoTsImportAlias>
      <_MetanoTsImportAlias Condition="'$(MetanoTsImportAlias)' != ''"
        >$(MetanoTsImportAlias)</_MetanoTsImportAlias>
      <_MetanoTsSourceCondition>$(MetanoSourceCondition)</_MetanoTsSourceCondition>
      <_MetanoTsSourceCondition Condition="'$(MetanoTsSourceCondition)' != ''"
        >$(MetanoTsSourceCondition)</_MetanoTsSourceCondition>
      <_MetanoTsSkipPackageJson>$(MetanoSkipPackageJson)</_MetanoTsSkipPackageJson>
      <_MetanoTsSkipPackageJson Condition="'$(MetanoTsSkipPackageJson)' != ''"
        >$(MetanoTsSkipPackageJson)</_MetanoTsSkipPackageJson>
      <_MetanoTsNamespaceBarrels>$(MetanoNamespaceBarrels)</_MetanoTsNamespaceBarrels>
      <_MetanoTsNamespaceBarrels Condition="'$(MetanoTsNamespaceBarrels)' != ''"
        >$(MetanoTsNamespaceBarrels)</_MetanoTsNamespaceBarrels>
      <_MetanoTsStripInterfacePrefix>$(MetanoStripInterfacePrefix)</_MetanoTsStripInterfacePrefix>
      <_MetanoTsStripInterfacePrefix Condition="'$(MetanoTsStripInterfacePrefix)' != ''"
        >$(MetanoTsStripInterfacePrefix)</_MetanoTsStripInterfacePrefix>
      <_MetanoTsFilePrefix>$(MetanoFilePrefix)</_MetanoTsFilePrefix>
      <_MetanoTsFilePrefix Condition="'$(MetanoTsFilePrefix)' != ''"
        >$(MetanoTsFilePrefix)</_MetanoTsFilePrefix>
      <_MetanoTsExtraArgs>$(MetanoExtraArgs)</_MetanoTsExtraArgs>
      <_MetanoTsExtraArgs Condition="'$(MetanoTsExtraArgs)' != ''"
        >$(MetanoTsExtraArgs)</_MetanoTsExtraArgs>
      <_MetanoTsPostBuildCommand>$(MetanoPostBuildCommand)</_MetanoTsPostBuildCommand>
      <_MetanoTsPostBuildCommand Condition="'$(MetanoTsPostBuildCommand)' != ''"
        >$(MetanoTsPostBuildCommand)</_MetanoTsPostBuildCommand>
      <_MetanoTsSkipToolCheck>$(MetanoSkipToolCheck)</_MetanoTsSkipToolCheck>
      <_MetanoTsSkipToolCheck Condition="'$(MetanoTsSkipToolCheck)' != ''"
        >$(MetanoTsSkipToolCheck)</_MetanoTsSkipToolCheck>
      <_MetanoTsCompilerProject>$(MetanoCompilerProject)</_MetanoTsCompilerProject>
      <_MetanoTsCompilerProject Condition="'$(MetanoTsCompilerProject)' != ''"
        >$(MetanoTsCompilerProject)</_MetanoTsCompilerProject>

      <_MetanoTsActive Condition="'$(_MetanoTsEnabled)' == 'true' and '$(_MetanoTsOutputDir)' != ''"
        >true</_MetanoTsActive>
      <_MetanoTsToolchainKeyFile>$(IntermediateOutputPath)$(MSBuildProjectFile).MetanoToolchain.typescript.cache</_MetanoTsToolchainKeyFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(_MetanoTsActive)' == 'true'">
      <_MetanoEnabledTarget
        Include="typescript"
        OutputDir="$(_MetanoTsOutputDir)"
        OutputDirFull="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_MetanoTsOutputDir)').TrimEnd('/\'))"
        ToolchainKeyFile="$(_MetanoTsToolchainKeyFile)"
        CompilerProject="$(_MetanoTsCompilerProject)"
        ToolStoreName="metano.compiler.typescript"
        PostBuildCommand="$([MSBuild]::Escape('$(_MetanoTsPostBuildCommand)'))"
      />
    </ItemGroup>
  </Target>

  <Target
    Name="MetanoTranspileTs"
    DependsOnTargets="_MetanoPrepare"
    Condition="'$(_MetanoTsActive)' == 'true'"
    Inputs="@(_MetanoUserCompile);@(MetanoAsset);$(MSBuildProjectFullPath);$(_MetanoTsToolchainKeyFile)"
    Outputs="$(_MetanoTsOutputDir)/.metano-stamp"
  >
    <PropertyGroup>
      <!-- Two modes:
           1. Installed tool (default): `dotnet metano-typescript`
           2. Local project (for development): `dotnet run - -project <path> - -` -->
      <_MetanoTsCommand Condition="'$(_MetanoTsCompilerProject)' == ''"
        >dotnet metano-typescript</_MetanoTsCommand>
      <_MetanoTsCommand Condition="'$(_MetanoTsCompilerProject)' != ''"
        >dotnet run --project "$(_MetanoTsCompilerProject)" --</_MetanoTsCommand>
      <_MetanoTsProbeTool
        Condition="'$(_MetanoTsCompilerProject)' == '' and '$(_MetanoTsSkipToolCheck)' != 'true'"
        >true</_MetanoTsProbeTool>
    </PropertyGroup>

    <!-- One MSBuild item per CLI flag. Each entry's Condition gates the flag on the resolved
         setting so empty values never reach the command line. Value-bearing flags carry the
         value inline (quoted) and bare flags render as just the switch token. -->
    <ItemGroup>
      <_MetanoTsArg Include="-p &quot;$(MSBuildProjectFullPath)&quot;" />
      <_MetanoTsArg Include="-o &quot;$(_MetanoTsOutputDir)&quot;" />
      <_MetanoTsArg Include="--clean" Condition="'$(_MetanoTsClean)' == 'true'" />
      <_MetanoTsArg Include="--time" Condition="'$(_MetanoTsShowTimings)' == 'true'" />
      <_MetanoTsArg
        Include="--dist &quot;$(_MetanoTsDist)&quot;"
        Condition="'$(_MetanoTsDist)' != ''"
      />
      <_MetanoTsArg
        Include="--package-root &quot;$(_MetanoTsPackageRoot)&quot;"
        Condition="'$(_MetanoTsPackageRoot)' != ''"
      />
      <_MetanoTsArg
        Include="--src-root &quot;$(_MetanoTsSrcRoot)&quot;"
        Condition="'$(_MetanoTsSrcRoot)' != ''"
      />
      <_MetanoTsArg
        Include="--import-alias &quot;$(_MetanoTsImportAlias)&quot;"
        Condition="'$(_MetanoTsImportAlias)' != ''"
      />
      <_MetanoTsArg
        Include="--source-condition &quot;$(_MetanoTsSourceCondition)&quot;"
        Condition="'$(_MetanoTsSourceCondition)' != ''"
      />
      <_MetanoTsArg
        Include="--skip-package-json"
        Condition="'$(_MetanoTsSkipPackageJson)' == 'true'"
      />
      <_MetanoTsArg
        Include="--namespace-barrels"
        Condition="'$(_MetanoTsNamespaceBarrels)' == 'true'"
      />
      <_MetanoTsArg
        Include="--strip-interface-prefix"
        Condition="'$(_MetanoTsStripInterfacePrefix)' == 'true'"
      />
      <_MetanoTsArg
        Include="--file-prefix &quot;$(_MetanoTsFilePrefix)&quot;"
        Condition="'$(_MetanoTsFilePrefix)' != ''"
      />
      <_MetanoTsArg Include="$(_MetanoTsExtraArgs)" Condition="'$(_MetanoTsExtraArgs)' != ''" />
    </ItemGroup>

    <PropertyGroup>
      <_MetanoTsArgs>@(_MetanoTsArg, ' ')</_MetanoTsArgs>
      <_MetanoTsToolInstallHint>Metano.Build.TypeScript does not bundle the compiler; install it as a local .NET tool from the repository root with `dotnet new tool-manifest` (once) and `dotnet tool install Metano.Compiler.TypeScript`, or globally with `dotnet tool install --global Metano.Compiler.TypeScript`. If the tool is already listed in .config/dotnet-tools.json, run `dotnet tool restore`. Set MetanoSkipToolCheck=true (or MetanoTsSkipToolCheck=true) to bypass this check.</_MetanoTsToolInstallHint>
    </PropertyGroup>

    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="_MetanoTranspileWorker"
      Properties="_MetanoWorkerLanguage=typescript;_MetanoWorkerOutputDir=$([MSBuild]::Escape('$(_MetanoTsOutputDir)'));_MetanoWorkerCommand=$([MSBuild]::Escape('$(_MetanoTsCommand)'));_MetanoWorkerArguments=$([MSBuild]::Escape('$(_MetanoTsArgs)'));_MetanoWorkerProbeTool=$(_MetanoTsProbeTool);_MetanoWorkerToolDescription=The Metano TypeScript compiler tool (metano-typescript);_MetanoWorkerToolInstallHint=$([MSBuild]::Escape('$(_MetanoTsToolInstallHint)'))"
    />
  </Target>
</Project>
