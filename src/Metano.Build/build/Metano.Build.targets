<Project>
  <!--
    Metano automatic TypeScript generation target.

    Runs the metano-typescript CLI after a successful Build when
    MetanoOutputDir is set. The CLI reads the compiled assembly via Roslyn,
    transforms annotated types into a TypeScript AST, and writes .ts files to
    the output directory.

    Configurable properties (set in the consuming .csproj):

      MetanoOutputDir        (required)  Where to write .ts files
      MetanoEnabled          (optional)  Opt-out switch. Defaults to true when
                                         MetanoOutputDir is set; set to false to
                                         skip the transpile target without unsetting
                                         the output dir (e.g., in CI variants that
                                         only want the .NET build).
      MetanoClean            (optional)  true to wipe the output dir first (default: false).
                                         Rarely needed: incremental builds self-prune orphaned
                                         generated files by reconciling the cache manifest, so a
                                         renamed/moved/deleted type no longer leaves stale output.
      MetanoDist             (optional)  JS dist dir relative to package root (default: ./dist)
      MetanoPackageRoot      (optional)  Root of the npm package. Default: the nearest directory with a
                                         package.json, searching up from OutputDir but never above the
                                         C# project directory, the repository root (.git) or the solution
                                         directory; without one, the parent of OutputDir. When that parent
                                         lies above the boundary the build fails with MS0044 (#334).
      MetanoSrcRoot          (optional)  TS source root relative to package root (default: inferred)
      MetanoImportAlias      (optional)  Isolated subpath-imports alias for internal imports in generated TS (e.g. `contracts` → `#contracts/...`). Lets generated code live in a subfolder of an existing npm project without colliding with that project's own `#` alias. Leading `#` optional; use a simple identifier (letters, digits, `-`, `_`). Default: unset (uses `#`). When several Metano projects target the same package, give each a distinct alias.
      MetanoSkipPackageJson  (optional)  true to skip package.json generation (default: false)
      MetanoShowTimings      (optional)  true to print timing info (default: false)
      MetanoNamespaceBarrels (optional)  true to emit a root src/index.ts barrel mirroring C# namespaces (default: false)
      MetanoStripInterfacePrefix (optional)  true to drop the `I` prefix from interface names when the second letter is uppercase (default: false). Collisions with sibling types surface MS0017.
      MetanoFilePrefix       (optional)  Verbatim text inserted at the top of every generated file, followed by a single newline. Use for formatter / lint directives (Biome `biome-ignore-all`, Prettier `// @prettier-ignore`, `// @generated` markers). Multi-line values are accepted; pass through MSBuild XML escaping.
      MetanoExtraArgs        (optional)  Additional CLI arguments
      MetanoPostBuildCommand (optional)  Shell command to run after transpilation completes. Receives the consumer's choice of formatter / linter / packager. Stays empty by default so the target ships no tool dependency; consumers opt in per project when they want the post-emit pass.
      MetanoSkipToolCheck    (optional)  true to skip the pre-flight check that the `metano-typescript` .NET tool is installed (default: false). The check only runs when the transpile target is out of date and not in dev mode (MetanoCompilerProject unset); when the tool is missing the build fails with METANOBUILD001 and the install instructions instead of the generic `dotnet-metano-typescript does not exist` message.

    Tool requirement:

      This package does NOT bundle the compiler: the target language is the
      consumer's choice. Install the TypeScript compiler as a .NET tool,
      preferably in a local tool manifest committed with the repository:

        dotnet new tool-manifest
        dotnet tool install Metano.Compiler.TypeScript

      or install it machine-wide with the tool install `global` flag.

    Asset item type (FR-048):

      <MetanoAsset Include="schema.sql" />
        Copies the file from the project directory to <MetanoOutputDir>,
        mirroring the relative path. `schema.sql` lands at
        $(MetanoOutputDir)/schema.sql; `assets/seed.json` lands at
        $(MetanoOutputDir)/assets/seed.json.

      Supported per-item metadata:
        OutputPath (optional)  Output-relative destination path. Overrides
                               the mirrored default. Use to relocate the
                               asset without renaming the source file.
                               `Output` is reserved by MSBuild (MSB4118),
                               so the metadata name is `OutputPath`.
        Language   (optional)  Which transpiler this asset applies to.
                               `typescript`, `dart`, `all`, or empty (=all).
                               Items not matching the active language are
                               dropped before the CLI sees them, so they
                               don't perturb the incremental cache
                               fingerprint. The metadata name is `Language`
                               because `Target` is reserved by MSBuild
                               (MSB4066).

      Declare the same Include twice with different OutputPath values to
      ship the asset to multiple destinations.
  -->

  <ItemDefinitionGroup>
    <MetanoAsset>
      <Language>all</Language>
    </MetanoAsset>
  </ItemDefinitionGroup>

  <PropertyGroup>
    <MetanoEnabled Condition="'$(MetanoEnabled)' == '' and '$(MetanoOutputDir)' != ''"
      >true</MetanoEnabled
    >
  </PropertyGroup>

  <!-- User-authored compilation inputs only — exclude items under
       $(IntermediateOutputPath) (e.g., the auto-generated
       obj/.../*.AssemblyInfo.cs which MSBuild touches on every build
       and would otherwise force MetanoTranspile to re-run every time. -->
  <Target Name="_MetanoCollectUserInputs" BeforeTargets="MetanoTranspile">
    <ItemGroup>
      <_MetanoUserCompile
        Include="@(Compile)"
        Condition="!$([System.String]::Copy('%(Compile.FullPath)').StartsWith('$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)'))'))"
      />
    </ItemGroup>
  </Target>

  <Target
    Name="MetanoTranspile"
    AfterTargets="Build"
    DependsOnTargets="_MetanoCollectUserInputs"
    Condition="'$(MetanoEnabled)' == 'true' and '$(MetanoOutputDir)' != ''"
    Inputs="@(_MetanoUserCompile);@(MetanoAsset);$(MSBuildProjectFullPath)"
    Outputs="$(MetanoOutputDir)/.metano-stamp"
  >
    <PropertyGroup>
      <!-- Two modes:
           1. Installed tool (default): `dotnet metano-typescript`
           2. Local project (for development): `dotnet run - -project <path> - -`
              Set MetanoCompilerProject to the compiler .csproj path to use this mode. -->
      <_MetanoCmd Condition="'$(MetanoCompilerProject)' == ''">dotnet metano-typescript</_MetanoCmd>
      <_MetanoCmd Condition="'$(MetanoCompilerProject)' != ''"
        >dotnet run --project "$(MetanoCompilerProject)" --</_MetanoCmd
      >

      <!-- Language tag used to filter <MetanoAsset Language="..."> items.
           The TypeScript build target defaults to "typescript"; downstream
           Dart-specific MSBuild integrations can override _MetanoTargetLanguage
           before this target runs to filter accordingly. -->
      <_MetanoTargetLanguage Condition="'$(_MetanoTargetLanguage)' == ''"
        >typescript</_MetanoTargetLanguage
      >
    </PropertyGroup>

    <!-- One MSBuild item per CLI flag, evaluated lazily. Each entry's
         Condition gates the flag on the corresponding consumer-set
         property so empty values never reach the command line. Value-
         bearing flags carry the value inline (quoted) and bare flags
         render as just the switch token. -->
    <ItemGroup>
      <_MetanoArg Include="-p &quot;$(MSBuildProjectFullPath)&quot;" />
      <_MetanoArg Include="-o &quot;$(MetanoOutputDir)&quot;" />
      <_MetanoArg Include="--clean" Condition="'$(MetanoClean)' == 'true'" />
      <_MetanoArg Include="--time" Condition="'$(MetanoShowTimings)' == 'true'" />
      <_MetanoArg Include="--dist &quot;$(MetanoDist)&quot;" Condition="'$(MetanoDist)' != ''" />
      <_MetanoArg
        Include="--package-root &quot;$(MetanoPackageRoot)&quot;"
        Condition="'$(MetanoPackageRoot)' != ''"
      />
      <_MetanoArg
        Include="--src-root &quot;$(MetanoSrcRoot)&quot;"
        Condition="'$(MetanoSrcRoot)' != ''"
      />
      <_MetanoArg
        Include="--import-alias &quot;$(MetanoImportAlias)&quot;"
        Condition="'$(MetanoImportAlias)' != ''"
      />
      <_MetanoArg Include="--skip-package-json" Condition="'$(MetanoSkipPackageJson)' == 'true'" />
      <_MetanoArg Include="--namespace-barrels" Condition="'$(MetanoNamespaceBarrels)' == 'true'" />
      <_MetanoArg
        Include="--strip-interface-prefix"
        Condition="'$(MetanoStripInterfacePrefix)' == 'true'"
      />
      <_MetanoArg
        Include="--file-prefix &quot;$(MetanoFilePrefix)&quot;"
        Condition="'$(MetanoFilePrefix)' != ''"
      />
      <_MetanoArg Include="$(MetanoExtraArgs)" Condition="'$(MetanoExtraArgs)' != ''" />
    </ItemGroup>

    <!-- Project @(MetanoAsset) items into asset CLI args.
         Filter by %(Language) against the active transpiler language;
         items carrying `all` or matching the language survive. Missing
         source files are intentionally NOT filtered here — the host
         must see them so it can raise MS0025 instead of letting a
         broken manifest pass silently. -->
    <ItemGroup>
      <_MetanoAssetSelected
        Include="@(MetanoAsset)"
        Condition="
        '%(MetanoAsset.Language)' == '$(_MetanoTargetLanguage)' or
          '%(MetanoAsset.Language)' == 'all'"
      />
      <_MetanoArg Include="@(_MetanoAssetSelected -> '--asset &quot;%(FullPath)=%(OutputPath)&quot;')" />
    </ItemGroup>

    <PropertyGroup>
      <_MetanoArgs>@(_MetanoArg, ' ')</_MetanoArgs>
    </PropertyGroup>

    <!-- Pre-flight: probe the installed tool before invoking it so a
         missing tool surfaces actionable install instructions instead of
         the dotnet host's generic "command not found" text. Lives inside
         this target (not in DependsOnTargets) so it only costs a process
         start when the transpile actually runs, never on up-to-date builds.
         Skipped in dev mode, where `dotnet run` builds the compiler itself. -->
    <PropertyGroup>
      <_MetanoShouldProbeTool
        Condition="'$(MetanoCompilerProject)' == '' and '$(MetanoSkipToolCheck)' != 'true'"
        >true</_MetanoShouldProbeTool
      >
    </PropertyGroup>
    <Exec
      Condition="'$(_MetanoShouldProbeTool)' == 'true'"
      Command="$(_MetanoCmd) --version"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      EchoOff="true"
      IgnoreExitCode="true"
      IgnoreStandardErrorWarningFormat="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low"
    >
      <Output TaskParameter="ExitCode" PropertyName="_MetanoToolProbeExitCode" />
    </Exec>
    <Error
      Condition="'$(_MetanoShouldProbeTool)' == 'true' and '$(_MetanoToolProbeExitCode)' != '0'"
      Code="METANOBUILD001"
      Text="The Metano TypeScript compiler tool (metano-typescript) is not available or could not be started for $(MSBuildProjectName) (`$(_MetanoCmd) --version` exited with code $(_MetanoToolProbeExitCode)). Metano.Build does not bundle the compiler; install it as a local .NET tool from the repository root with `dotnet new tool-manifest` (once) and `dotnet tool install Metano.Compiler.TypeScript`, or globally with `dotnet tool install --global Metano.Compiler.TypeScript`. If the tool is already listed in .config/dotnet-tools.json, run `dotnet tool restore`. Set MetanoSkipToolCheck=true to bypass this check."
    />

    <Message
      Importance="high"
      Text="Metano: Transpiling $(MSBuildProjectName) → $(MetanoOutputDir)"
    />
    <Exec
      Command="$(_MetanoCmd) $(_MetanoArgs)"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      ConsoleToMSBuild="true"
      StandardOutputImportance="High"
    />
  </Target>

  <!--
    Optional post-emit hook. Runs the consumer-provided command in
    MetanoPostBuildCommand (a verbatim shell line) after transpilation.
    Use it to run a formatter / linter / packager on the generated output
    so the committed state matches whatever the consumer's tooling
    produces. Stays inert when the property is unset, so the target ships
    no implicit tool dependency.
  -->
  <Target
    Name="MetanoPostBuild"
    AfterTargets="MetanoTranspile"
    Condition="'$(MetanoPostBuildCommand)' != ''"
  >
    <Message
      Importance="high"
      Text="Metano: Running post-build command for $(MSBuildProjectName)"
    />
    <Exec
      Command="$(MetanoPostBuildCommand)"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      ConsoleToMSBuild="true"
      StandardOutputImportance="High"
    />
  </Target>
</Project>
