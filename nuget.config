<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin this repository to a single package source so builds are hermetic and
    independent of any sources defined in the developer's global NuGet config.
    <clear /> drops inherited sources (e.g. private feeds for other projects),
    which avoids NU1507 under Central Package Management (TreatWarningsAsErrors).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
