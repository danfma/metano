<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The transpile-conformance probes (see README.md). Every public static string method of a
    *Probes class is one row: it runs on .NET here (Runner.cs) and, transpiled by the in-repo
    TypeScript CLI, on Bun and Node. This project is deliberately NOT part of Metano.slnx, so
    `dotnet build Metano.slnx` never compiles the probes; scripts/run-conformance.sh builds it.
    The probes are deliberately sloppy C# (unused members, nullable noise), hence the relaxed
    warning policy.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8604;CS8618;CS8625;CS0649;CS0169;CS8629;CS8601;CS0659;CS0661;CS8765;CS8767;CS0162;CS8619;CS8620;CS8851;CS0168;CS0219;CS1718;CA2200</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="xpkg/**" />
    <ProjectReference Include="../../src/Metano/Metano.csproj" />
    <ProjectReference Include="xpkg/Lib/ConformanceLib.csproj" />
  </ItemGroup>
</Project>
