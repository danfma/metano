<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Metano/Metano.csproj" />
    <ProjectReference Include="../../src/Metano.Compiler.TypeScript/Metano.Compiler.TypeScript.csproj" />
    <ProjectReference Include="../../src/Metano.Compiler.Dart/Metano.Compiler.Dart.csproj" />
    <!-- The JSX golden tests compile inline C# against the real SolidJS/DOM
         bindings so the goldens are authoritative against the shipped binding
         (e.g. ClassName's [Name("class")] override). Referenced here so the
         binding assemblies land in the test output for the inline compiler. -->
    <ProjectReference Include="../../bindings/Metano.TypeScript.SolidJs/Metano.TypeScript.SolidJs.csproj" />
    <ProjectReference Include="../../bindings/Metano.TypeScript.DOM/Metano.TypeScript.DOM.csproj" />
  </ItemGroup>

  <!-- The MS0013 source-generator tests (#247) run the real System.Text.Json
       source generator over inline compilations. Its location is whatever
       analyzer the SDK hands this very project, so record that path as
       assembly metadata instead of guessing the targeting-pack layout. When no
       analyzer matches, the metadata value is blank and the test helper
       rejects it with an explicit error. -->
  <Target
    Name="EmbedJsonSourceGeneratorPath"
    BeforeTargets="GetAssemblyAttributes"
    DependsOnTargets="ResolveTargetingPackAssets"
  >
    <ItemGroup>
      <_JsonSourceGenerator
        Include="@(Analyzer)"
        Condition="'%(Filename)' == 'System.Text.Json.SourceGeneration'"
      />
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>JsonSourceGeneratorPath</_Parameter1>
        <_Parameter2>@(_JsonSourceGenerator->'%(FullPath)')</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="Expected/**/*.ts" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Expected/**/*.tsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
